# SECURE WEB AUTHENTICATION AND INTELLIGENT SESSION STATE MANAGEMENT SYSTEM
# Environment Configuration Template

# Server Port
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/secure_web_auth_fsm
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/secure_web_auth_fsm?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/secure_web_auth_fsm

# Express Session Encryption Secret (Use a strong random string)
SESSION_SECRET=cybersecurity_formal_automata_session_key_ultra_secure_2026
